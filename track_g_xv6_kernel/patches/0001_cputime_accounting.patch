diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index cd25557..5a77b6c 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -110,3 +110,21 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+// return how many CPU timer ticks have been charged
+// to the calling process.
+uint64
+sys_getcputime(void)
+{
+  struct proc *p = myproc();
+  uint64 ct;
+
+  if (p == 0)
+    return -1;
+
+  acquire(&p->lock);
+  ct = p->cputime;
+  release(&p->lock);
+
+  return ct;
+}
