  "bernstein_vazirani": {
    "target_101": {
      "algorithm": "Bernstein-Vazirani",
      "secret_target": "101",
      "measured_secret": "101",
      "is_correct": true,
      "success_fraction": 1.0,
      "counts": {
        "101": 1024
      },
      "num_qubits": 4,
      "circuit_depth": 6,
      "total_gates": 10,
      "gate_counts": {
        "h": 7,
        "measure": 3,
        "barrier": 2,
        "cx": 2,
        "x": 1
      },
      "gate_explanations": [
        {
          "gate": "X(ancilla)",
          "purpose": "Flips the ancilla qubit from |0> to |1> so the subsequent Hadamard produces the |- > state."
        },
        {
          "gate": "H(ancilla)",
          "purpose": "Transforms ancilla |1> into |-> = (|0> - |1>)/sqrt(2), enabling phase kickback (-1)^f(x)."
        },
        {
          "gate": "H(q[0])",
          "purpose": "Creates an equal superposition (|0> + |1>)/sqrt(2) on input qubit 0."
        },
        {
          "gate": "H(q[1])",
          "purpose": "Creates an equal superposition (|0> + |1>)/sqrt(2) on input qubit 1."
        },
        {
          "gate": "H(q[2])",
          "purpose": "Creates an equal superposition (|0> + |1>)/sqrt(2) on input qubit 2."
        },
        {
          "gate": "CNOT(control=q[0], target=ancilla)",
          "purpose": "Applies conditional phase kickback for bit position 0 because secret[0] == '1'."
        },
        {
          "gate": "CNOT(control=q[2], target=ancilla)",
          "purpose": "Applies conditional phase kickback for bit position 2 because secret[2] == '1'."
        },
        {
          "gate": "H(q[0])",
          "purpose": "Interferes the kicked phases; constructively interferes to |secret[0]> and destructively cancels the opposite basis state."
        },
        {
          "gate": "H(q[1])",
          "purpose": "Interferes the kicked phases; constructively interferes to |secret[1]> and destructively cancels the opposite basis state."
        },
        {
          "gate": "H(q[2])",
          "purpose": "Interferes the kicked phases; constructively interferes to |secret[2]> and destructively cancels the opposite basis state."
        },
        {
          "gate": "Measure(q[0] -> c[0])",
          "purpose": "Collapses input qubit 0 into the classical measurement register."
        },
        {
          "gate": "Measure(q[1] -> c[1])",
          "purpose": "Collapses input qubit 1 into the classical measurement register."
        },
        {
          "gate": "Measure(q[2] -> c[2])",
          "purpose": "Collapses input qubit 2 into the classical measurement register."
        }
      ],
      "diagram_file": "C:\\Users\\Soham Umesh Chavan\\OT-8\\OT_Lab-8\\track_i_quantum_algorithms\\circuits\\bernstein_vazirani_101.txt"
    },
